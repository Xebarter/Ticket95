# ===========================================
# Supabase Configuration
# ===========================================
# Get these values from your Supabase project settings
# Dashboard: https://supabase.com/dashboard/projects
# Navigate to: Settings > API

# Your Supabase project URL (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase public anon key (Required)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase service role key for server-side operations
# ⚠️ NEVER expose this in frontend code - server-side only!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# Application Configuration
# ===========================================

# Application URL (Required for auth redirects)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# Paytota Payment Configuration
# ===========================================
# Dashboard: https://gate.paytota.com/
# Use your secret key and brand ID from the Paytota merchant portal.

# Paytota secret key (Required for server-side payment API calls)
PAYTOTA_SECRET_KEY=your-paytota-secret-key

# Paytota brand ID (Required)
PAYTOTA_BRAND_ID=your-paytota-brand-id

# Paytota API base URL (Optional, defaults to production gateway)
PAYTOTA_BASE_URL=https://gate.paytota.com

# Webhook URL to configure in Paytota dashboard:
# Purchases: {NEXT_PUBLIC_APP_URL}/api/payments/paytota/webhook
# Payouts / disbursements: {NEXT_PUBLIC_APP_URL}/api/payments/paytota/payout-webhook
#
# Ensure the Paytota brand has sufficient payout balance for organizer/affiliate
# mobile money disbursements (minimum UGX 20,000 per request).

# ===========================================
# DPO Pay Configuration (Card Payments)
# ===========================================
# Docs: https://docs.dpopay.com/dpo-pay-by-network/reference/create-token
# Contact DPO for test/live credentials.

# DPO company token (Required for card payments)
DPO_COMPANY_TOKEN=your-dpo-company-token

# DPO service type (Required, provided during merchant onboarding)
DPO_SERVICE_TYPE=your-dpo-service-type

# DPO API URL (Optional, defaults to production)
# DPO_API_URL=https://secure.3gdirectpay.com/API/v6/

# DPO hosted payment page URL (Optional, defaults to production)
# DPO_PAY_URL=https://secure.3gdirectpay.com/pay.asp

# Webhook / callback URLs to note:
# BackURL (per-token, set automatically): {NEXT_PUBLIC_APP_URL}/api/payments/dpo/callback
# Push Payments webhook (configure in DPO portal): {NEXT_PUBLIC_APP_URL}/api/payments/dpo/webhook

# ===========================================
# Email Configuration (Supabase Settings)
# ===========================================
# Configure these in Supabase Dashboard > Authentication > Email Templates
# 
# Email Templates to configure:
# 1. Confirm signup
# 2. Reset password
# 3. Magic Link
# 4. Change email address
# 5. Invite user
#
# Redirect URLs to add in Supabase Dashboard > Authentication > URL Configuration:
# - http://localhost:3000/auth/callback (development)
# - http://localhost:3000/** (development wildcard — recommended)
# - http://localhost:3000/auth/reset-password (development)
# - https://your-domain.com/auth/callback (production)
# - https://your-domain.com/** (production wildcard — recommended)
#
# Google OAuth (Supabase Dashboard > Authentication > Providers > Google):
# 1. Enable Google provider
# 2. Add your Google Cloud OAuth client ID and secret
# 3. Ensure /auth/callback is listed in redirect URLs above
